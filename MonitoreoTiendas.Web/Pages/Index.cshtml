@page
@model MonitoreoTiendas.Web.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Monitoreo de tiendas | Curlingtech</title>

    <style>
            :root {
                --bg-main: #f3f6f8;
                --bg-card: #ffffff;
                --bg-header: #123047;
                --text-main: #172b3a;
                --text-muted: #647887;
                --border-color: #e1e8ed;
                --table-header-bg: #fbfcfd;
                --table-border: #edf1f3;
                --input-bg: #ffffff;
                --input-border: #d5dfe5;
            }

            /* Estilos Modo Oscuro (Dark Mode NOC) */
            body.dark-mode {
                --bg-main: #0b131e;
                --bg-card: #152232;
                --bg-header: #080e18;
                --text-main: #e2e8f0;
                --text-muted: #94a3b8;
                --border-color: #233549;
                --table-header-bg: #1a2a3d;
                --table-border: #1e2d40;
                --input-bg: #1e2d40;
                --input-border: #334155;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--bg-main);
                color: var(--text-main);
                font-family: "Segoe UI", Arial, sans-serif;
                transition: background 0.3s ease, color 0.3s ease;
            }

            header {
                background: var(--bg-header);
                color: white;
                padding: 18px max(24px, calc((100% - 1280px) / 2));
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
            }

            .brand {
                color: #63d1c4;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 2px;
            }

            h1 {
                margin: 6px 0 2px;
                font-size: 25px;
            }

            header p {
                margin: 0;
                color: #c6d4de;
                font-size: 13px;
            }

            /* Controles Kiosk / NOC (Header) */
            .kiosk-controls {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255, 255, 255, 0.08);
                padding: 8px 12px;
                border-radius: 8px;
                border: 1px solid rgba(255, 255, 255, 0.12);
            }

            .btn-noc {
                background: #1e3a52;
                color: #ffffff;
                border: 1px solid #365875;
                padding: 6px 12px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
                text-decoration: none;
            }

                .btn-noc:hover {
                    background: #284c6b;
                }

                .btn-noc.active {
                    background: #0d6efd;
                    border-color: #0d6efd;
                    box-shadow: 0 0 8px rgba(13, 110, 253, 0.5);
                }

            main {
                max-width: 1280px;
                margin: 28px auto;
                padding: 0 22px;
        flex: 1;
        width: 100%;
            }

            /* SLA & Cards Grid (6 Tarjetas) */
            .summary {
                display: grid;
                grid-template-columns: repeat(6, 1fr);
                gap: 14px;
                margin-bottom: 22px;
            }

            .card, .panel, .alert-panel {
                background: var(--bg-card);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            }

            .card {
                padding: 18px 20px;
            }

            .card-label {
                color: var(--text-muted);
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
            }

            .card-number {
                display: block;
                margin-top: 6px;
                font-size: 26px;
                font-weight: 700;
            }

            .card-subtext {
                display: block;
                margin-top: 4px;
                font-size: 12px;
                font-weight: 600;
            }

            /* Alert Panel */
            .alert-panel {
                border-left: 5px solid #d9534f;
                padding: 16px 20px;
                margin-bottom: 22px;
                background: rgba(217, 83, 79, 0.08);
            }

            .alert-heading {
                font-size: 14px;
                font-weight: 700;
                color: #a33c3c;
                margin-bottom: 8px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            body.dark-mode .alert-heading {
                color: #f87171;
            }

            .alert-item {
                font-size: 13px;
                color: var(--text-main);
                padding: 4px 0;
                border-bottom: 1px dashed rgba(217, 83, 79, 0.2);
            }

                .alert-item:last-child {
                    border-bottom: 0;
                }

            .panel {
                overflow: hidden;
            }

            .panel-heading {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 18px 20px;
                border-bottom: 1px solid var(--border-color);
            }

            h2 {
                margin: 0;
                font-size: 18px;
            }

            .updated {
                color: var(--text-muted);
                font-size: 13px;
            }

            .error {
                margin: 18px;
                padding: 14px;
                border-radius: 8px;
                color: #842029;
                background: #f8d7da;
            }

            .empty {
                padding: 32px 20px;
                color: var(--text-muted);
                text-align: center;
            }

            .table-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 1280px;
            }

            th, td {
                padding: 14px 18px;
                border-bottom: 1px solid var(--table-border);
                text-align: left;
                vertical-align: middle;
            }

            th {
                color: var(--text-muted);
                background: var(--table-header-bg);
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            tbody tr:last-child td {
                border-bottom: 0;
            }

            /* Filas por prioridad */
            tr.priority-critical {
                background-color: #fff5f5;
            }

            tr.priority-warning {
                background-color: #fffdf0;
            }

            body.dark-mode tr.priority-critical {
                background-color: #2b1518;
            }

            body.dark-mode tr.priority-warning {
                background-color: #2b2413;
            }

            .store-name {
                font-weight: 650;
            }

            .store-code, .muted {
                display: block;
                margin-top: 3px;
                color: var(--text-muted);
                font-size: 12px;
            }

            .status {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 6px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

                .status::before {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: currentColor;
                    content: "";
                }

            .network-status {
                display: inline-block;
                border-radius: 14px;
                padding: 5px 9px;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

            .threshold-badge {
                display: inline-block;
                margin-top: 4px;
                padding: 2px 6px;
                border-radius: 4px;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
            }

            .badge-danger {
                color: #a33c3c;
                background: #fbeaea;
            }

            .badge-warning {
                color: #8b6410;
                background: #fff4d8;
            }

            .network-ok {
                color: #167447;
                background: #e6f5ed;
            }

            .network-failed {
                color: #a33c3c;
                background: #fbeaea;
            }

            .network-na {
                color: #5c6870;
                background: #edf0f2;
            }

            .playing {
                color: #167447;
                background: #e6f5ed;
            }

            .no-signal {
                color: #8b6410;
                background: #fff4d8;
            }

            .not-authorized {
                color: #842029;
                background: #f8d7da;
            }

            .closed, .offline {
                color: #a33c3c;
                background: #fbeaea;
            }

            .not-required, .unknown {
                color: #5c6870;
                background: #edf0f2;
            }

            /* Ajustes Modo Oscuro para Insignias */
            body.dark-mode .playing {
                color: #4ade80;
                background: #143823;
            }

            body.dark-mode .no-signal {
                color: #facc15;
                background: #382d0d;
            }

            body.dark-mode .not-authorized {
                color: #f87171;
                background: #3d1719;
            }

            body.dark-mode .closed, body.dark-mode .offline {
                color: #f87171;
                background: #381416;
            }

            body.dark-mode .not-required, body.dark-mode .unknown, body.dark-mode .network-na {
                color: #94a3b8;
                background: #1e293b;
            }

            body.dark-mode .network-ok {
                color: #4ade80;
                background: #143823;
            }

            body.dark-mode .network-failed {
                color: #f87171;
                background: #381416;
            }

            footer {
                width: 100%;
                margin: 12px 0 0;
                padding: 8px 22px;
                color: #c6d4de;
                background: var(--bg-header);
                border-top: 1px solid #365875;
                font-size: 12px;
                text-align: center;
            }

            @@media (max-width: 1100px) {
                .summary {
                    grid-template-columns: repeat(3, 1fr);
                }
            }

            @@media (max-width: 650px) {
                .summary {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 450px) {
                .summary {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>
    <header>
        <div>
            <div class="brand">CURLINGTECH · NOC CONSOLE</div>
            <h1>Monitoreo de Tiendas</h1>
            <p>
                @(string.IsNullOrWhiteSpace(Model.SelectedCountry)
                    ? "Monitoreo internacional de todas las tiendas"
                    : $"Monitoreo de tiendas en {Model.SelectedCountry}")
            </p>
        </div>

        <div class="kiosk-controls">
            <a href="@Model.ComplianceReportUrl" target="_blank" class="btn-noc">
                📥 Exportar Auditoría (CSV)
            </a>
            <button id="btnDarkMode" class="btn-noc" onclick="toggleDarkMode()">
                🌙 Modo Oscuro
            </button>
            <button id="btnRotation" class="btn-noc" onclick="toggleRotation()">
                🔄 Auto-Rotación: OFF
            </button>
        </div>
    </header>

    <main>
        <!-- Tarjetas SLA, Auditoría y Métricas Sintéticas -->
        <section class="summary">
            <div class="card">
                <span class="card-label">SLA Disponibilidad</span>
                <span class="card-number" style="color: #0d6efd;">@Model.GlobalSlaPercent%</span>
                <span class="card-subtext" style="color: #198754;">🟢 Operación Evaluada</span>
            </div>
            <div class="card">
                <span class="card-label">Cumplimiento Oficial</span>
                <span class="card-number" style="color: #198754;">@Model.GlobalCompliancePercent%</span>
                <span class="card-subtext" style="color: #198754;">📜 Lista autorizada</span>
            </div>
            <div class="card">
                <span class="card-label">Tiendas reportando</span>
                <span class="card-number">@Model.Stores.Count</span>
                <span class="card-subtext" style="color: var(--text-muted);">Total registradas</span>
            </div>
            <div class="card">
                <span class="card-label">Reproduciendo</span>
                <span class="card-number">@Model.PlayingCount</span>
                <span class="card-subtext" style="color: #198754;">🟢 Transmisión activa</span>
            </div>
            <div class="card">
                <span class="card-label">Sin señal de audio</span>
                <span class="card-number">@Model.NoSignalCount</span>
                <span class="card-subtext" style="color: #ffc107;">⚠️ Revisar audio</span>
            </div>
            <div class="card">
                <span class="card-label">Sin comunicación</span>
                <span class="card-number" style="color: #dc3545;">@Model.OfflineCount</span>
                <span class="card-subtext" style="color: #dc3545;">🔴 Requieren atención</span>
            </div>
        </section>

        <!-- Filtro por País -->
        <form method="get" style="display: flex; align-items: center; gap: 10px; margin-bottom: 22px;">
            <label for="pais" style="font-weight: 600; color: var(--text-muted);">Filtrar por país:</label>
            <select id="pais" name="pais" onchange="this.form.submit()"
                    style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--input-bg); color: var(--text-main);">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.SelectedCountry) ? "selected" : null)">Todos los países</option>
                @foreach (var country in Model.AvailableCountries)
                {
                    <option value="@country" selected="@(country.Equals(Model.SelectedCountry, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@country</option>
                }
            </select>
        </form>

        <!-- Bloque de Alertas Tempranas (Visibilidad por Excepción) -->
        @if (Model.SystemAlerts.Count > 0)
        {
            <section class="alert-panel">
                <div class="alert-heading">
                    🚨 ALERTAS DE PREVENCIÓN Y REACCIÓN (Acción Inmediata)
                </div>
                @foreach (var alert in Model.SystemAlerts)
                {
                    <div class="alert-item">@alert</div>
                }
            </section>
        }

        <section class="panel">
            <div class="panel-heading">
                <h2>Tiendas</h2>
                <span class="updated">
                    Actualizado: @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                    · refresco automático cada 30s
                </span>
            </div>

            @if (Model.ErrorMessage is not null)
            {
                <div class="error">@Model.ErrorMessage</div>
            }
            else if (Model.Stores.Count == 0)
            {
                <div class="empty">
                    Aún no hay reportes. Mantén la API y el agente ejecutándose.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Tienda</th>
                                <th>País</th>
                                <th>Estado</th>
                                <th>Cumplimiento SLA</th>
                                <th>Reproductor</th>
                                <th>Windows</th>
                                <th>CPU</th>
                                <th>Memoria</th>
                                <th>Disco</th>
                                <th>Dispositivo de red</th>
                                <th>Último reporte</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var store in Model.Stores)
                            {
                                bool isOffline = Model.GetStatusClass(store) == "offline";
                                bool isClosed = Model.GetStatusClass(store) == "closed";
                                bool hasResourceWarning = Model.HasCpuWarning(store) || Model.HasRamWarning(store) || Model.HasDiskWarning(store);
                                string rowClass = isOffline || isClosed ? "priority-critical" : (hasResourceWarning ? "priority-warning" : "");
                                double compliance = Model.GetCompliancePercent(store);

                                <tr class="@rowClass">
                                    <td>
                                        <span class="store-name">@store.Report.StoreName</span>
                                        <span class="store-code">@store.Report.StoreCode</span>
                                    </td>
                                    <td>@store.Report.Pais</td>
                                    <td>
                                        <span class="status @Model.GetStatusClass(store)">
                                            @Model.GetStatus(store)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!store.Report.ActivoMusica)
                                        {
                                            <span class="status not-required">N/A</span>
                                        }
                                        else if (compliance == 100)
                                        {
                                            <span class="status network-ok">100% Autorizado</span>
                                        }
                                        else
                                        {
                                            <span class="status network-failed">0% No Autorizado</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="font-weight: 600;">@store.Report.Player.PlayerName</div>
                                        @if (!string.IsNullOrWhiteSpace(store.Report.Player.Title))
                                        {
                                            <div style="font-size: 12px; color: #167447; margin-top: 3px; font-weight: 600;">
                                                🎵 @store.Report.Player.Title
                                                @if (!string.IsNullOrWhiteSpace(store.Report.Player.Artist))
                                                {
                                                    <span style="color: var(--text-muted); font-weight: normal;">— @store.Report.Player.Artist</span>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(store.Report.Player.Details))
                                        {
                                            <div class="muted" style="font-size: 11px; margin-top: 2px;">
                                                ℹ️ @store.Report.Player.Details
                                            </div>
                                        }
                                    </td>
                                    <td>@store.Report.WindowsEdition</td>

                                    <!-- CPU con indicador de Umbral -->
                                    <td>
                                        <div>@Model.GetCpuSummary(store)</div>
                                        @if (Model.HasCpuWarning(store))
                                        {
                                            <span class="threshold-badge badge-danger">⚠️ Saturado</span>
                                        }
                                    </td>

                                    <!-- Memoria con indicador de Umbral -->
                                    <td>
                                        <div>@Model.GetMemorySummary(store)</div>
                                        @if (Model.HasRamWarning(store))
                                        {
                                            <span class="threshold-badge badge-warning">⚠️ Límite</span>
                                        }
                                    </td>

                                    <!-- Disco C: con indicador de Umbral -->
                                    <td>
                                        <div>@Model.GetDiskSummary(store)</div>
                                        @if (Model.HasDiskWarning(store))
                                        {
                                            <span class="threshold-badge badge-danger">⚠️ Crítico</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="network-status @Model.GetNetworkClass(store)"
                                              title="@(store.Report.Network?.Details ?? "Sin información")">
                                            @Model.GetNetworkSummary(store)
                                        </span>
                                    </td>
                                    <td>
                                        @store.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </main>

    <footer>
        <div>Curlingtechnologies · Derechos reservados 2026</div>
        <div>
            Desarrollado por
            <a href="https://www.facebook.com/CurlingTech/"
               target="_blank"
               rel="noopener noreferrer">Curlingtech</a>
            · La página se actualiza automáticamente cada 30 segundos.
        </div>
    </footer>

    <!-- Lógica de Cliente para Modo Oscuro y Auto-Rotación Kiosk -->
    <script>
            const availableCountries = @Html.Raw(Json.Serialize(Model.AvailableCountries));
            let rotationTimer = null;
            let isRotating = localStorage.getItem("noc_rotation") === "true";

            // 1. Cargar persistencia de Modo Oscuro
            if (localStorage.getItem("noc_theme") === "dark") {
                document.body.classList.add("dark-mode");
                document.getElementById("btnDarkMode").classList.add("active");
            }

            function toggleDarkMode() {
                document.body.classList.toggle("dark-mode");
                const isDark = document.body.classList.contains("dark-mode");
                localStorage.setItem("noc_theme", isDark ? "dark" : "light");
                document.getElementById("btnDarkMode").classList.toggle("active", isDark);
            }

            // 2. Control del Switch de Auto-Rotación por País
            function toggleRotation() {
                isRotating = !isRotating;
                localStorage.setItem("noc_rotation", isRotating);
                updateRotationButton();

                if (isRotating) {
                    startRotation();
                } else {
                    if (rotationTimer) clearTimeout(rotationTimer);
                }
            }

            function updateRotationButton() {
                const btn = document.getElementById("btnRotation");
                if (isRotating) {
                    btn.innerHTML = "🔄 Auto-Rotación: ON (15s)";
                    btn.classList.add("active");
                } else {
                    btn.innerHTML = "🔄 Auto-Rotación: OFF";
                    btn.classList.remove("active");
                }
            }

            function startRotation() {
                if (!availableCountries || availableCountries.length === 0) return;

                const urlParams = new URLSearchParams(window.location.search);
                const currentCountry = urlParams.get('pais')?.trim() || "";

                let nextIndex = -1;
                if (currentCountry) {
                    nextIndex = availableCountries.findIndex(c => c.toLowerCase() === currentCountry.toLowerCase());
                }

                nextIndex = nextIndex + 1; // Siguiente elemento en el ciclo

                rotationTimer = setTimeout(() => {
                    if (nextIndex >= availableCountries.length) {
                        // Retornar a vista "Todos los países"
                        window.location.href = window.location.pathname;
                    } else {
                        // Navegar al siguiente país
                        window.location.href = window.location.pathname + "?pais=" + encodeURIComponent(availableCountries[nextIndex]);
                    }
                }, 15000); // Intervalo de 15 segundos entre vistas
            }

            // Inicialización al cargar la página
            if (isRotating) {
                updateRotationButton();
                startRotation();
            } else {
                // Recargar estándar a los 30s en modo estático
                setTimeout(() => {
                    window.location.reload();
                }, 30000);
            }
    </script>
</body>
</html>